# ---------------------------------------------------------------------------
# Florida Security Concepts — environment template
# Copy to .env.local for local dev, or set in your hosting provider for prod.
# Do NOT commit .env.local. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap, schema, OG/Twitter tags.
# Override per environment (preview, staging, production).
NEXT_PUBLIC_SITE_URL=https://floridasecurityconcepts.com

# ---------------------------------------------------------------------------
# Lead delivery mode — controls how /api/leads forwards captured leads.
# Supported: console, resend, webhook, supabase, resend+supabase
# Production recommended: resend+supabase (sends customer email AND writes
# the lead into Prime's leads table for measurement).
# Production: must be set, otherwise /api/leads returns 503 configuration error.
# ---------------------------------------------------------------------------

# Local / dev fallback — logs leads to the server console.
LEAD_DELIVERY_MODE=console

# ---- Production (recommended): Resend email notifications ------------------
# Switch to:
# LEAD_DELIVERY_MODE=resend
#
# Then provide all three:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# LEAD_NOTIFICATION_TO=alerts@floridasecurityconcepts.com
# LEAD_NOTIFICATION_FROM=leads@floridasecurityconcepts.com
#
# Notes:
#  - LEAD_NOTIFICATION_TO accepts a single address or comma-separated list.
#  - LEAD_NOTIFICATION_FROM must be a verified sender on a domain you've
#    verified in Resend (or use the Resend onboarding domain for testing).
#  - The submitter's email is set as Reply-To on the internal notification.
#
# Customer confirmation email (sent to the submitter on every successful lead):
# Defaults are sensible — the confirmation is enabled by default in resend mode
# and uses LEAD_NOTIFICATION_FROM as its sender unless overridden. Override only
# if you need a separate sender or a specific Reply-To.
#
# LEAD_CONFIRMATION_ENABLED=true
#  - Set to "false", "0", "no", or "off" to disable customer confirmation.
#  - Anything else (or unset) = enabled.
#
# LEAD_CONFIRMATION_FROM=
#  - Optional sender for the customer confirmation. Falls back to
#    LEAD_NOTIFICATION_FROM. Must be on a Resend-verified domain.
#
# LEAD_CONFIRMATION_REPLY_TO=
#  - Optional Reply-To on the customer confirmation. Falls back to the first
#    address in LEAD_NOTIFICATION_TO so customer replies route to the company
#    inbox.

# ---- Generic webhook (HubSpot, Zapier, Make, n8n, internal CRM) ------------
# Switch to:
# LEAD_DELIVERY_MODE=webhook
#
# Then provide:
# LEADS_WEBHOOK_URL=https://hooks.example.com/inbound/leads
# LEADS_WEBHOOK_SECRET=
#  - LEADS_WEBHOOK_SECRET is optional; when set it is sent as
#    `X-Webhook-Secret` so the receiver can verify the request origin.

# ---- Prime backend (cross-project Supabase write) --------------------------
# Used when LEAD_DELIVERY_MODE includes "supabase" (i.e. "supabase" or
# "resend+supabase"). Writes the validated lead into Prime's leads table
# so Prime can measure FSC's lead volume / attribution alongside other
# tenants.
#
# All three are required when supabase delivery is active. Set in Vercel
# environment variables for the FSC project. Server-only — never prefix
# with NEXT_PUBLIC_.
#
# PRIME_SUPABASE_URL=https://<ref>.supabase.co
# PRIME_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# PRIME_ACCOUNT_SLUG=fsc
